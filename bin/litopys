#!/usr/bin/env bash
# litopys CLI - deterministic chronicle writer, no model, no tokens.
#
#   Usage: bash bin/litopys append --kind <kind> --ref <path> [--note "<text>"]
#          bash bin/litopys distill record --journal <raw.md> --body <body.md|->
#          bash bin/litopys distill next | distill finish
#          bash bin/litopys bench | privacy
#          bash bin/litopys --version | help
#
# Invoked as `bash "${CLAUDE_PLUGIN_ROOT}/bin/litopys" <sub>` (C2) so Windows never
# depends on PATH exec of an extension-less file.
#
# `append` mirrors VULYK's scripts/journal.sh: create-with-header-if-missing, append one
# line, print the same line to stdout. After argument validation it is never a gate - a
# chronicle record that cannot be written must not break the caller that wanted to write it.
set -u

VERSION="0.3.0"
KINDS="grill brief verdict ship handoff note session"

usage() {
  cat >&2 <<EOF
litopys $VERSION
  litopys append --kind <$(echo "$KINDS" | tr ' ' '|')> --ref <path|sha> [--note "<text>"]
      Append one dated line to <root>/docs/chronicle/YYYY-MM.md. Idempotent on (ts, kind, ref).
  litopys distill record --journal <raw.md> --body <body.md|-> [--topics a,b] [--links x,y]
                         [--source live|backfill] [--model <m>] [--force]
      Turn one raw journal plus one distilled body into docs/chronicle/sessions/<date>-<sid8>.md,
      append one session line to the monthly chronicle, move the journal to .litopys/raw/done/.
  litopys distill next [--max N]
      Take the distill.lock mutex (stale after 30 minutes), park eligible bench, user-less and
      already-distilled journals in .litopys/raw/skipped/, print up to N (default 3) eligible
      journal paths oldest first. A journal whose session may still be running is never moved.
  litopys distill finish
      Release the distill lock. Records stay local ('kept local: ...') unless
      LITOPYS_TRACK_CHRONICLE=1, which commits only the paths this run wrote
      (.litopys/distill.paths) on the current branch, never the host's other staged or unstaged
      work, and prints 'committed <sha7>' or 'uncommitted: <reason>'. Always exit 0.
  litopys corrections [--since YYYY-MM-DD] [--lexicon <file>]
      Print '<date> · <session8> · record · «quote»' for every ## Corrections line of the session
      records; with --lexicon (one ERE per line, the consumer's own), also '<date> · <session8> ·
      lexicon · «line»' for every ## user line of the raw journals that matches. Read-only, exit 0.
  litopys privacy
      Make <root>/.gitignore carry the litopys block (.litopys/ and docs/chronicle/*), verify it
      with git, and print one status line; warns about litopys files git already tracks and
      never touches the index. The SessionStart hook runs this every session.
  litopys bench
      Ask every question in <root>/docs/chronicle/golden-questions.md through
      /litopys:recall and append one JSON row per question to <root>/.litopys/baseline.jsonl.
  litopys bench --delta
      Print the last five rows of <root>/.litopys/baseline.jsonl against its first five
      (hits, refs, seconds, tokens, cost) - no model call. Fewer than ten rows exits 2.
  litopys --version       Print $VERSION.
  litopys help            This text.

Environment: CLAUDE_PROJECT_DIR (project root override), LITOPYS_NOW (UTC ISO clock override),
LITOPYS_CLAUDE (claude binary used by bench), CLAUDE_PLUGIN_ROOT (this plugin's root),
LITOPYS_TRACK_CHRONICLE=1 (commit docs/chronicle/ instead of git-ignoring it).
EOF
}

# C1 - project root: CLAUDE_PROJECT_DIR, then git toplevel, then \$PWD.
project_root() {
  if [ -n "${CLAUDE_PROJECT_DIR:-}" ] && [ -d "${CLAUDE_PROJECT_DIR:-}" ]; then
    printf '%s\n' "$CLAUDE_PROJECT_DIR"
    return 0
  fi
  local top
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if [ -n "$top" ] && [ -d "$top" ]; then
    printf '%s\n' "$top"
    return 0
  fi
  printf '%s\n' "$PWD"
}

# C16 - which secret filter runs. The host project's own scripts/redact.sh wins (its patterns
# are the ones its owner maintains), then the plugin's shipped copy, then the copy next to this
# script when CLAUDE_PLUGIN_ROOT is unset. None of the three present -> `cat`: redaction is
# best-effort and never a gate, exactly as it was when only the host copy counted.
redactor() { # redactor [root] - print a filter path, or the literal `cat`
  local root="${1:-$(project_root)}" here
  if [ -f "$root/scripts/redact.sh" ]; then printf '%s\n' "$root/scripts/redact.sh"; return 0; fi
  if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -f "${CLAUDE_PLUGIN_ROOT}/scripts/redact.sh" ]; then
    printf '%s\n' "${CLAUDE_PLUGIN_ROOT}/scripts/redact.sh"; return 0
  fi
  here="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)"
  if [ -n "$here" ] && [ -f "$here/scripts/redact.sh" ]; then printf '%s\n' "$here/scripts/redact.sh"; return 0; fi
  printf '%s\n' "cat"
}

redact_filter() { # redact_filter <redactor-path> - stdin -> stdout, `cat` when there is none
  if [ "$1" = "cat" ]; then cat; else bash "$1"; fi
}

# C1 - every writer of .litopys/ comes through here, so the self-ignore cannot be forgotten by
# the next writer someone adds. Non-zero when the directory or its .gitignore cannot be written.
ensure_scratch() { # ensure_scratch <root>
  mkdir -p "$1/.litopys" 2>/dev/null || return 1
  [ -f "$1/.litopys/.gitignore" ] || printf '*\n' > "$1/.litopys/.gitignore" 2>/dev/null || return 1
}

# --- privacy guard (C17) --------------------------------------------------------------------
# Everything litopys generates in a host stays out of git by default: raw journals are full
# transcripts, and a distilled record is still a summary of a private conversation that the
# redactor's key patterns cannot judge. The host's own <root>/.gitignore carries one managed
# block; only that block is ever rewritten, and only when its content differs from what the
# current mode wants. LITOPYS_TRACK_CHRONICLE=1 is the explicit opt-in that lets a team commit
# docs/chronicle/ again (the ADR-007 commit in `distill finish`); .litopys/ is private always.
# `.litopys/` is unanchored so a nested sub/.litopys/ is covered too; golden-questions.md is
# written by the owner, not generated, so it stays trackable.
PRIVACY_BEGIN='# >>> litopys - private session data, kept out of git by the litopys plugin >>>'
PRIVACY_END='# <<< litopys <<<'

privacy_block() { # the managed block for the current mode, marker lines included
  printf '%s\n' "$PRIVACY_BEGIN" \
    '# rewritten every session; to commit the chronicle set LITOPYS_TRACK_CHRONICLE=1' \
    '.litopys/'
  if [ "${LITOPYS_TRACK_CHRONICLE:-}" != "1" ]; then
    printf '%s\n' 'docs/chronicle/*' '!docs/chronicle/golden-questions.md'
  fi
  printf '%s\n' "$PRIVACY_END"
}

privacy_label() { # the protected paths, for humans
  if [ "${LITOPYS_TRACK_CHRONICLE:-}" = "1" ]; then printf '.litopys/'; else printf '.litopys/ docs/chronicle/'; fi
}

# Markers match by prefix, so a later version's reworded marker still finds an older block. The
# block is the last begin marker before the first end marker; a begin with no end after it is
# never a block, so a half-deleted block cannot swallow the rest of the owner's file.
ensure_private() { # ensure_private <root> - prints ok|added|updated|symlink|nogit|nogitbin|failed
  local root="$1" gi want have tmp
  if ! command -v git > /dev/null 2>&1; then printf 'nogitbin\n'; return 0; fi
  if [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]; then
    printf 'nogit\n'; return 0
  fi
  gi="$root/.gitignore"
  # A symlinked .gitignore is the owner's own arrangement (or a trap in an untrusted checkout):
  # never written through, never replaced. cmd_privacy's git checks still judge the result.
  if [ -L "$gi" ]; then printf 'symlink\n'; return 0; fi
  want="$(privacy_block)"
  if [ ! -f "$gi" ]; then
    if printf '%s\n' "$want" > "$gi" 2>/dev/null; then printf 'added\n'; else printf 'failed\n'; fi
    return 0
  fi
  have="$(awk '{ l = $0; sub(/\r$/, "", l) }
    e { next }
    index(l, "# >>> litopys") == 1 { buf = l; b = 1; next }
    b { buf = buf "\n" l }
    b && index(l, "# <<< litopys") == 1 { e = 1 }
    END { if (e) print buf }' "$gi" 2>/dev/null)"
  [ "$have" = "$want" ] && { printf 'ok\n'; return 0; }
  tmp="$gi.litopys.$$"
  if LITOPYS_BLOCK="$want" awk '
      NR == FNR { l = $0; sub(/\r$/, "", l)
                  if (!e && index(l, "# >>> litopys") == 1) b = FNR
                  else if (b && !e && index(l, "# <<< litopys") == 1) e = FNR
                  next }
      b && e && FNR >= b && FNR <= e { if (FNR == b) print ENVIRON["LITOPYS_BLOCK"]; next }
      { print; last = $0 }
      END { if (!(b && e)) { sub(/\r$/, "", last); if (last != "") print ""; print ENVIRON["LITOPYS_BLOCK"] } }
    ' "$gi" "$gi" > "$tmp" 2>/dev/null && mv -f "$tmp" "$gi" 2>/dev/null; then
    if [ -n "$have" ]; then printf 'updated\n'; else printf 'added\n'; fi
  else
    rm -f "$tmp" 2>/dev/null || true
    printf 'failed\n'
  fi
}

guard_private() { # guard_private <root> - ensure_private for the CLI writers: a note on stderr
                  # when it had to change the owner's .gitignore, silence otherwise
  case "$(ensure_private "$1")" in
    added|updated) echo "litopys: git-ignored $(privacy_label) in $1/.gitignore" >&2 ;;
  esac
  return 0
}

# One line, `[litopys] privacy:` when nothing needs the owner and `[litopys] PRIVACY:` when
# something does. It never contains `"` or `\` - the hook's no-jq path embeds it in JSON as is.
cmd_privacy() {
  if [ $# -gt 0 ]; then
    echo "litopys privacy: takes no arguments (got '$1')" >&2; usage; return 2
  fi
  local root state label probe tracked others n m bad="" msg="" note="" loud=0
  # The litopys pathspecs, as an array for git and as text for the command printed to the owner.
  local -a scope=(.litopys '*/.litopys/*' docs/chronicle)
  local shown=".litopys '*/.litopys/*' docs/chronicle"
  if [ "${LITOPYS_TRACK_CHRONICLE:-}" = "1" ]; then
    scope=(.litopys '*/.litopys/*'); shown=".litopys '*/.litopys/*'"
  fi
  root="$(project_root)"
  state="$(ensure_private "$root")"
  label="$(privacy_label)"
  case "$state" in
    nogitbin) echo "[litopys] PRIVACY: git not found - .gitignore not checked"; return 0 ;;
    nogit)    echo "[litopys] privacy: not a git repository - nothing to guard"; return 0 ;;
    failed)   echo "[litopys] PRIVACY: cannot write .gitignore - $label NOT git-ignored"; return 0 ;;
    added)    msg="added $label to .gitignore - commit it"; loud=1 ;;
    updated)  msg="rewrote the litopys block in .gitignore - commit it"; loud=1 ;;
    symlink)  note=" (.gitignore is a symlink - checked, not rewritten)" ;;
  esac

  # git's own matcher is the judge: a later `!` rule or a nested .gitignore can undo the block.
  for probe in .litopys/raw/probe.md docs/chronicle/probe.md docs/chronicle/sessions/probe.md; do
    case "$probe" in docs/*) [ "${LITOPYS_TRACK_CHRONICLE:-}" = "1" ] && continue ;; esac
    if ! git -C "$root" check-ignore -q --no-index -- "$probe" 2>/dev/null; then
      case " $bad " in *" ${probe%/*}/ "*) : ;; *) bad="${bad:+$bad }${probe%/*}/" ;; esac
    fi
  done
  if [ -n "$bad" ]; then
    msg="${msg:+$msg · }NOT ignored: $bad - a later .gitignore rule overrides the litopys block"; loud=1
  fi
  # ... and the real files: an owner rule like `!docs/chronicle/sessions/2026-*` un-ignores real
  # records while every probe name above stays ignored.
  others="$(git -C "$root" ls-files --others --exclude-standard -- "${scope[@]}" 2>/dev/null \
    | grep -vx 'docs/chronicle/golden-questions.md' || true)"
  m="$(printf '%s' "$others" | grep -c . 2>/dev/null || true)"
  m="${m:-0}"
  if [ "$m" -gt 0 ]; then
    msg="${msg:+$msg · }$m litopys file(s) NOT ignored - git would add them; a .gitignore rule un-ignores them"; loud=1
  fi

  # Tracked before the block existed: .gitignore cannot hide those. The command is printed,
  # never run - untracking stages deletions on the owner's branch. It lists exactly the pathspecs
  # the count used, so running it clears this warning.
  tracked="$(git -C "$root" ls-files -ci --exclude-standard -- "${scope[@]}" 2>/dev/null || true)"
  n="$(printf '%s' "$tracked" | grep -c . 2>/dev/null || true)"
  n="${n:-0}"
  if [ "$n" -gt 0 ]; then
    msg="${msg:+$msg · }$n litopys file(s) already tracked by git - untrack: git ls-files -ci --exclude-standard -z -- $shown | xargs -0 git rm --cached --quiet -- ; then commit (history already pushed stays on the remote)"
    loud=1
  fi

  if [ "$loud" -eq 1 ]; then
    echo "[litopys] PRIVACY: $msg$note"
  elif [ "${LITOPYS_TRACK_CHRONICLE:-}" = "1" ]; then
    echo "[litopys] privacy: .litopys/ git-ignored ✓ · docs/chronicle/ tracked on purpose (LITOPYS_TRACK_CHRONICLE=1)$note"
  else
    echo "[litopys] privacy: $label git-ignored ✓$note"
  fi
  return 0
}

cmd_append() {
  local kind="" ref="" note=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --kind|--ref|--note)
        if [ $# -lt 2 ]; then
          echo "litopys append: $1 needs a value" >&2; usage; return 2
        fi
        case "$1" in
          --kind) kind="$2" ;;
          --ref)  ref="$2" ;;
          --note) note="$2" ;;
        esac
        shift 2
        ;;
      *) echo "litopys append: unknown argument '$1'" >&2; usage; return 2 ;;
    esac
  done

  if [ -z "$kind" ]; then
    echo "litopys append: --kind is required" >&2; usage; return 2
  fi
  case " $KINDS " in
    *" $kind "*) : ;;
    *) echo "litopys append: --kind must be one of: $KINDS" >&2; usage; return 2 ;;
  esac
  if [ -z "$ref" ]; then
    echo "litopys append: --ref is required" >&2; usage; return 2
  fi

  local root ts month file prefix line found
  root="$(project_root)"
  ts="${LITOPYS_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  month="$(printf '%s' "$ts" | cut -c1-7)"

  # Secrets never reach a committed chronicle line. Both fields go through the same C16 filter
  # (host copy first, plugin copy second) - its absence is impossible to rely on, and a failure
  # of the filter falls back to the unfiltered text rather than dropping the record (C3).
  local filter
  filter="$(redactor "$root")"
  if [ -n "$note" ]; then
    note="$(printf '%s\n' "$note" | redact_filter "$filter" 2>/dev/null || printf '%s' "$note")"
  fi
  # One record = one line: newlines, carriage returns and tabs collapse to spaces.
  note="$(printf '%s' "$note" | tr '\n\r\t' '   ')"

  # C3 amended: --ref is normalised to one line, its ' · ' separators neutralised so a ref can
  # never forge a second field, and then redacted like --note. A ref that is empty afterwards
  # would write a record nothing can be keyed on.
  ref="$(printf '%s' "$ref" | tr '\n\r\t' '   ')"
  ref="${ref// · / - }"
  ref="$(printf '%s\n' "$ref" | redact_filter "$filter" 2>/dev/null || printf '%s' "$ref")"
  ref="$(trim "$ref")"
  if [ -z "$ref" ]; then
    echo "litopys append: --ref is empty after normalisation" >&2; usage; return 2
  fi

  guard_private "$root"
  file="$root/docs/chronicle/$month.md"
  if [ ! -f "$file" ]; then
    mkdir -p "$root/docs/chronicle" || { echo "litopys append: cannot create $root/docs/chronicle" >&2; return 0; }
    printf '# Chronicle %s\n\n' "$month" > "$file"
  fi

  prefix="- $ts · $kind · $ref · "
  line="$prefix$note"
  found="$(awk -v p="$prefix" 'index($0, p) == 1 { print; exit }' "$file" 2>/dev/null || true)"
  if [ -n "$found" ]; then
    printf '%s\n' "$found"
    return 0
  fi

  printf '%s\n' "$line" >> "$file"
  printf '%s\n' "$line"
  return 0
}

wsnorm() { # wsnorm <string> - every whitespace run becomes one space, ends trimmed
  local s; s="$(printf '%s' "$1" | tr '\r\n\t' '   ' | sed -E 's/[[:space:]]+/ /g')"
  trim "$s"
}

trim() { # trim <string> - strip leading and trailing whitespace
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# C5 token extraction. `claude -p --output-format json` reports the input side in three fields:
# `usage.input_tokens` alone is the *uncached* slice - a couple of tokens per call - while cache
# creation and cache read carry the actual spend (live probe: input 2, cache_creation 50520,
# cache_read 0, output 4). Reading `input_tokens` alone read ~0 on every real row in round 1
# (Ask 4), so `tokens_in` sums all three input fields instead. `modelUsage` is the same
# information per model in camelCase; it is the fallback when a top-level `usage` object exists
# but is all-zero. `null` is written only when neither object is present at all. Within one
# object, snake_case and camelCase are never both summed - each field prefers its snake_case
# value when present, falling back to camelCase only when the snake field is absent, so a
# payload carrying both spellings of the same field is never double-counted.
BENCH_USAGE_JQ='
def num($v): if ($v | type) == "number" then $v else 0 end;
def pick($snake; $camel): if ($snake | type) == "number" then $snake else num($camel) end;
def tin($u):  pick($u.input_tokens;  $u.inputTokens)
            + pick($u.cache_creation_input_tokens; $u.cacheCreationInputTokens)
            + pick($u.cache_read_input_tokens;     $u.cacheReadInputTokens);
def tout($u): pick($u.output_tokens; $u.outputTokens);
(if (.usage | type) == "object" then {i: tin(.usage), o: tout(.usage)} else null end) as $top
| (if (.modelUsage | type) == "object"
   then (.modelUsage | to_entries | map(.value))
        | {i: (map(tin(.)) | add // 0), o: (map(tout(.)) | add // 0)}
   else null end) as $mod
| (if   $top != null and ($top.i + $top.o) > 0 then $top
   elif $mod != null and ($mod.i + $mod.o) > 0 then $mod
   elif $top != null then $top
   else $mod end) as $u
| [ (if $u == null then "null" else ($u.i | tostring) end),
    (if $u == null then "null" else ($u.o | tostring) end),
    (.total_cost_usd // null | tostring) ] | @tsv'

# C15 - `bench --delta`: baseline = the first five rows of baseline.jsonl in file order, latest
# = the last five. Five sums, one line, no claude call. A sum is `null` (delta `n/a`) when any
# of its five rows carries `null` for that field - never silently treated as 0. Plain counts
# (hits, refs, seconds) show a signed delta with "+0" when equal; percentages (tokens, cost) are
# integer, relative to the baseline sum, truncated toward zero, and show "0%" (no sign) when
# equal.
DELTA_JQ='
def hitcount($a): ($a | map(select(.hit == true)) | length);
def sumor0($a; $f): ($a | map(.[$f] // 0) | add // 0);
def anynull($a; $f): ($a | map(.[$f]) | any(. == null));
def sumnullable($a; $f): if anynull($a; $f) then null else sumor0($a; $f) end;
def trunc0: if . < 0 then (- ((-.) | floor)) else floor end;
def signed(n): if n >= 0 then "+\(n)" else "\(n)" end;
def numstr(v): if v == null then "null" else (v | tostring) end;
def pctstr(b; l): if b == null or l == null then "n/a"
  elif b == 0 then (if l == 0 then "0%" else "n/a" end)
  else ( (( (l - b) * 100 / b ) | trunc0) as $p | (if $p == 0 then "0%" else (signed($p) + "%") end) ) end;
.[0:5] as $base | .[-5:] as $latest |
(hitcount($base)) as $hb | (hitcount($latest)) as $hl |
(sumor0($base;"refs_matched")) as $rmb | (sumor0($latest;"refs_matched")) as $rml |
(sumor0($base;"refs_expected")) as $reb | (sumor0($latest;"refs_expected")) as $rel |
(sumor0($base;"seconds")) as $sb | (sumor0($latest;"seconds")) as $sl |
(sumnullable($base;"tokens_in")) as $tib | (sumnullable($latest;"tokens_in")) as $til |
(sumnullable($base;"tokens_out")) as $tob | (sumnullable($latest;"tokens_out")) as $tol |
(sumnullable($base;"cost_usd")) as $cb | (sumnullable($latest;"cost_usd")) as $cl |
"delta vs baseline · hits \($hb)/5 -> \($hl)/5 (\(signed($hl-$hb))) · refs \($rmb)/\($reb) -> \($rml)/\($rel) (\(signed($rml-$rmb))) · seconds \($sb) -> \($sl) (\(signed($sl-$sb))) · tokens_in \(numstr($tib)) -> \(numstr($til)) (\(pctstr($tib;$til))) · tokens_out \(numstr($tob)) -> \(numstr($tol)) (\(pctstr($tob;$tol))) · cost_usd \(numstr($cb)) -> \(numstr($cl)) (\(pctstr($cb;$cl)))"'

cmd_bench_delta() {
  if [ $# -gt 0 ]; then
    echo "litopys bench --delta: takes no arguments (got '$1')" >&2; usage; return 2
  fi
  if ! command -v jq > /dev/null 2>&1; then
    echo "litopys bench --delta: jq not found - delta parses baseline.jsonl with jq" >&2; return 2
  fi

  local root file n
  root="$(project_root)"
  file="$root/.litopys/baseline.jsonl"
  if [ ! -f "$file" ]; then
    echo "litopys bench --delta: no baseline at $file" >&2; return 2
  fi
  n="$(grep -c . "$file" 2>/dev/null || true)"
  n="${n:-0}"
  if [ "$n" -lt 10 ]; then
    echo "litopys bench --delta: baseline.jsonl has $n row(s), need at least 10 (5 baseline + 5 latest)" >&2
    return 2
  fi

  jq -r -s "$DELTA_JQ" "$file"
  return 0
}

# `bench` is a manual/CLI mode: it must never read stdin, or a terminal run with an open pipe
# would block forever (VULYK's handoff.py "manual modes must NOT read stdin" bug). Every
# child process that could inherit the terminal gets </dev/null.
cmd_bench() {
  if [ "${1:-}" = "--delta" ]; then
    shift
    cmd_bench_delta "$@"
    return $?
  fi
  if [ $# -gt 0 ]; then
    echo "litopys bench: takes no arguments (got '$1')" >&2; usage; return 2
  fi
  if ! command -v jq > /dev/null 2>&1; then
    echo "litopys bench: jq not found - bench parses claude's JSON output with jq" >&2; return 2
  fi

  local root qfile plugin_root
  root="$(project_root)"
  qfile="$root/docs/chronicle/golden-questions.md"
  plugin_root="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
  if [ ! -f "$qfile" ]; then
    echo "litopys bench: no golden questions at $qfile" >&2; return 2
  fi

  # --- C4 parse: five '## Q<n> ·' sections, each with answer: and refs: ---------------------
  local -a qid qtext qans qrefs
  local n=0 line rest
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    case "$line" in
      '## Q'*)
        n=$((n + 1))
        rest="${line#'## '}"
        qid[$n]="${rest%% *}"
        case "$rest" in
          *' · '*) qtext[$n]="$(trim "${rest#* · }")" ;;
          *)       qtext[$n]="" ;;
        esac
        qans[$n]=""
        qrefs[$n]=""
        ;;
      '- answer:'*) if [ "$n" -gt 0 ]; then qans[$n]="$(trim "${line#- answer:}")"; fi ;;
      '- refs:'*)   if [ "$n" -gt 0 ]; then qrefs[$n]="$(trim "${line#- refs:}")"; fi ;;
    esac
  done < "$qfile"

  local bad="" i
  if [ "$n" -ne 5 ]; then
    bad="expected exactly five '## Q<n> ·' sections, found $n"
  else
    for i in 1 2 3 4 5; do
      case "${qid[$i]:-}" in
        Q[0-9]*) : ;;
        *) bad="section $i is not '## Q<n> · <question>'"; break ;;
      esac
      if [ -z "${qtext[$i]:-}" ]; then bad="${qid[$i]} has no question text after ' · '"; break; fi
      if [ -z "${qans[$i]:-}" ];  then bad="${qid[$i]} has no 'answer:' keyphrases"; break; fi
      if [ -z "${qrefs[$i]:-}" ]; then bad="${qid[$i]} has no 'refs:'"; break; fi
    done
  fi
  if [ -n "$bad" ]; then
    echo "litopys bench: malformed $qfile - $bad" >&2; return 2
  fi

  # --- C1: .litopys/ exists and ignores itself before anything is written -------------------
  if ! ensure_scratch "$root"; then
    echo "litopys bench: cannot create $root/.litopys" >&2; return 2
  fi
  guard_private "$root"

  local out_file="$root/.litopys/baseline.jsonl"
  local claude_bin="${LITOPYS_CLAUDE:-claude}"
  local project ts errfile
  project="$(basename "$root")"
  ts="${LITOPYS_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  errfile="$(mktemp 2>/dev/null || printf '%s' "$root/.litopys/.bench-stderr")"

  local hits=0 refs_hit=0 refs_exp=0 total=0
  local -a keys refs
  local out rc res started ended secs kp ref matched nkeys nrefs err meta ti to cost hit k row
  local is_err failed unparsable
  for i in 1 2 3 4 5; do
    IFS='|' read -r -a keys <<< "${qans[$i]}"
    IFS=';' read -r -a refs <<< "${qrefs[$i]}"

    : > "$errfile"
    started="$(date +%s)"
    out="$(cd "$root" && "$claude_bin" -p --plugin-dir "$plugin_root" --model sonnet \
      --output-format json "/litopys:recall ${qtext[$i]}" 2>"$errfile" < /dev/null)"
    rc=$?
    ended="$(date +%s)"
    secs=$((ended - started))
    [ "$secs" -ge 0 ] || secs=0
    total=$((total + secs))

    # Non-JSON stdout on an exit-0 call (a claude invocation that answered with plain text, no
    # `--output-format json` envelope) is scored as a miss without pretending it parsed.
    unparsable=0
    if [ "$rc" -eq 0 ] && ! printf '%s' "$out" | jq -e . > /dev/null 2>&1; then
      unparsable=1
    fi

    res="$(printf '%s' "$out" | jq -r '.result // ""' 2>/dev/null || true)"
    meta="$(printf '%s' "$out" | jq -r "$BENCH_USAGE_JQ" 2>/dev/null || true)"
    IFS=$'\t' read -r ti to cost <<< "$meta"
    ti="${ti:-null}"; to="${to:-null}"; cost="${cost:-null}"

    # A call is failed if claude exited non-zero, answered with "is_error":true - an error
    # report in the result field, never an answer - or its stdout could not be parsed at all.
    is_err="$(printf '%s' "$out" | jq -r 'if (.is_error == true) then 1 else 0 end' 2>/dev/null || true)"
    failed=0
    if [ "$rc" -ne 0 ] || [ "${is_err:-0}" = "1" ] || [ "$unparsable" -eq 1 ]; then failed=1; fi

    hit=false
    nkeys=0
    if [ "$failed" -eq 0 ]; then
      for k in "${keys[@]}"; do
        kp="$(trim "$k")"
        [ -n "$kp" ] || continue
        nkeys=$((nkeys + 1))
        if printf '%s' "$res" | grep -qiF -- "$kp"; then hit=true; break; fi
      done
    fi

    matched=0
    nrefs=0
    for k in "${refs[@]}"; do
      ref="$(trim "$k")"
      [ -n "$ref" ] || continue
      nrefs=$((nrefs + 1))
      if [ "$failed" -eq 0 ] && printf '%s' "$res" | grep -qF -- "$ref"; then
        matched=$((matched + 1))
      fi
    done

    [ "$hit" = true ] && hits=$((hits + 1))
    refs_hit=$((refs_hit + matched))
    refs_exp=$((refs_exp + nrefs))

    row="$(jq -cn --arg ts "$ts" --arg project "$project" --arg q "${qid[$i]}" \
      --arg question "${qtext[$i]}" --argjson hit "$hit" --argjson refs_expected "$nrefs" \
      --argjson refs_matched "$matched" --argjson tokens_in "$ti" --argjson tokens_out "$to" \
      --argjson cost_usd "$cost" --argjson seconds "$secs" --arg model sonnet \
      --arg litopys "$VERSION" \
      '{ts:$ts,project:$project,q:$q,question:$question,hit:$hit,refs_expected:$refs_expected,refs_matched:$refs_matched,tokens_in:$tokens_in,tokens_out:$tokens_out,cost_usd:$cost_usd,seconds:$seconds,model:$model,litopys:$litopys}')"

    if [ "$failed" -eq 1 ]; then
      if [ "$unparsable" -eq 1 ]; then
        err="unparsable stdout"
      elif [ "$rc" -ne 0 ]; then
        err="$(head -n 1 "$errfile" 2>/dev/null || true)"
        [ -n "$err" ] || err="$(printf '%s' "$out" | head -n 1)"
        [ -n "$err" ] || err="claude exited $rc"
      else
        err="$(printf '%s' "$res" | head -n 1)"
        [ -n "$err" ] || err="is_error"
      fi
      row="$(printf '%s' "$row" | jq -c --arg error "$err" '. + {error:$error}')"
    fi
    printf '%s\n' "$row" >> "$out_file"
  done
  rm -f "$errfile" 2>/dev/null || true

  echo "hits $hits/5 · refs $refs_hit/$refs_exp · ${total}s"
  return 0
}

# --- distill (C11-C14) ---------------------------------------------------------------------
# `distill record` is the model-free half of distillation: the forked distiller agent reads a
# raw journal and writes a body; this turns the pair into the git-tracked session record. It
# validates everything it can before it writes anything - a rejected body must leave the
# journal exactly where it was, still distillable.

csv_list() { # csv_list "a, b" -> "[a, b]"   (empty -> "[]")
  local raw="$1" out="" item
  local -a parts=()
  IFS=',' read -r -a parts <<< "$raw"
  for item in ${parts[@]+"${parts[@]}"}; do
    item="$(trim "$item")"
    [ -n "$item" ] || continue
    if [ -z "$out" ]; then out="$item"; else out="$out, $item"; fi
  done
  printf '[%s]' "$out"
}

json_str() { # json_str <text> - JSON string escaping without jq: backslash, quote, tab, CR and
             # LF escaped, any other control character dropped - one row stays one line.
  # One character at a time on purpose: `${s//pat/rep}` treats a backslash or quote in `rep`
  # differently in bash 3.2, 4.x and 5.2 (patsub_replacement), and macOS still ships 3.2. The
  # inputs are short (a timestamp, an id, a path, a model name).
  local s="$1" out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c="${s:i:1}"
    case "$c" in
      \\) out="$out"'\\' ;;
      '"') out="$out"'\"' ;;
      $'\t') out="$out"'\t' ;;
      $'\r') out="$out"'\r' ;;
      $'\n') out="$out"'\n' ;;
      [[:cntrl:]]) : ;;
      *) out="$out$c" ;;
    esac
  done
  printf '%s' "$out"
}

# The record path is built from journal frontmatter, which is data and never a path: the date
# must look like a date (else the fallback clock's, else zeros) and the id keeps [A-Za-z0-9_-]
# only - no `/`, no `.`, nothing that can climb out of docs/chronicle/sessions/. `distill next`
# derives the same path to spot a resumed session, so both go through this one function.
record_rel() { # record_rel <started> <sid> <fallback-ts> - docs/chronicle/sessions/<date>-<sid8>.md
  local d s
  d="$(printf '%s' "$1" | cut -c1-10)"
  case "$d" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;; *) d="$(printf '%s' "$3" | cut -c1-10)" ;; esac
  case "$d" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) : ;; *) d="0000-00-00" ;; esac
  s="$(printf '%s' "$2" | tr -c 'A-Za-z0-9_-' '_' | cut -c1-8)"
  printf 'docs/chronicle/sessions/%s-%s.md\n' "$d" "$s"
}

bytes() { # bytes <file> - size in bytes, digits only
  wc -c < "$1" 2>/dev/null | tr -dc '0-9'
}

distill_record() {
  local journal="" bodyarg="" topics="" links="" source="live" model="sonnet" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --journal|--body|--topics|--links|--source|--model)
        if [ $# -lt 2 ]; then
          echo "litopys distill record: $1 needs a value" >&2; usage; return 2
        fi
        case "$1" in
          --journal) journal="$2" ;;
          --body)    bodyarg="$2" ;;
          --topics)  topics="$2" ;;
          --links)   links="$2" ;;
          --source)  source="$2" ;;
          --model)   model="$2" ;;
        esac
        shift 2
        ;;
      --force) force=1; shift ;;
      *) echo "litopys distill record: unknown argument '$1'" >&2; usage; return 2 ;;
    esac
  done

  if [ -z "$journal" ]; then
    echo "litopys distill record: --journal is required" >&2; usage; return 2
  fi
  if [ ! -f "$journal" ]; then
    echo "litopys distill record: no journal at $journal" >&2; return 2
  fi
  if [ -z "$bodyarg" ]; then
    echo "litopys distill record: --body is required" >&2; usage; return 2
  fi
  if [ "$bodyarg" != "-" ] && [ ! -f "$bodyarg" ]; then
    echo "litopys distill record: no body at $bodyarg" >&2; return 2
  fi
  case "$source" in
    live|backfill) : ;;
    *) echo "litopys distill record: --source must be live or backfill (got '$source')" >&2; return 2 ;;
  esac
  [ -n "$model" ] || model="sonnet"

  # --- journal: frontmatter + C13 block scan -----------------------------------------------
  local sid="" started="" branch="" line key val fm=0 last_header="" ended="-" inuser=0 human=""
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    if [ "$fm" -eq 0 ] && [ "$line" = "---" ]; then fm=1; continue; fi
    if [ "$fm" -eq 1 ]; then
      if [ "$line" = "---" ]; then fm=2; continue; fi
      key="${line%%:*}"; val="$(trim "${line#*:}")"
      case "$key" in
        session_id) sid="$val" ;;
        started)    started="$val" ;;
        branch)     branch="$val" ;;
      esac
      continue
    fi
    case "$line" in
      '## '*) last_header="$line"; case "$line" in '## user'*) inuser=1 ;; *) inuser=0 ;; esac ;;
      *) [ "$inuser" -eq 1 ] && human="$human $line" ;;
    esac
  done < "$journal"

  if [ -z "$sid" ]; then
    echo "litopys distill record: $journal has no session_id in its frontmatter" >&2; return 2
  fi
  # C13: one journal = one record whatever the number of closed/compact markers. `ended` is the
  # last `## closed` only when it is also the file's last block - anything after it is a resume.
  case "$last_header" in
    '## closed'*)
      ended="$(trim "${last_header#'## closed'}")"
      ended="$(trim "${ended#·}")"
      ended="$(trim "${ended%%·*}")"
      ;;
  esac
  [ -n "$ended" ] || ended="-"
  [ -n "$branch" ] || branch="-"

  # --- body: one title, the four C11 sections, in order ------------------------------------
  local body title="" first=1
  local -a secs=()
  if [ "$bodyarg" = "-" ]; then body="$(cat)"; else body="$(cat "$bodyarg")"; fi
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    if [ "$first" -eq 1 ]; then
      [ -n "$(trim "$line")" ] || continue
      case "$line" in
        '# '*) title="$(trim "${line#\# }")"; first=0; continue ;;
        *) echo "litopys distill record: body must start with a '# <title>' line" >&2; return 2 ;;
      esac
    fi
    case "$line" in '## '*) secs+=("$(trim "${line#\#\# }")") ;; esac
  done <<< "$body"

  if [ "$first" -eq 1 ] || [ -z "$title" ]; then
    echo "litopys distill record: body is empty or has no '# <title>' line" >&2; return 2
  fi
  if [ "${secs[*]:-}" != "Decisions Corrections Problems Brainstorm Links" ]; then
    echo "litopys distill record: body needs exactly '## Decisions', '## Corrections', '## Problems', '## Brainstorm', '## Links' in that order (got: ${secs[*]:-none})" >&2
    return 2
  fi

  # --- quotes: the owner's exact words or nothing (correction-evidence C2, ADR-011) ---------
  # A «quote» ends a `## Decisions` line (` — «…»`) or opens a `## Corrections` line
  # (`- «…» — what`). It must be a whitespace-normalised substring of the journal's `## user`
  # text; `## notice` blocks never count. A miss refuses the whole record, as a failed redactor does.
  local hay sec="" q
  hay="$(wsnorm "$human")"
  while IFS= read -r line || [ -n "$line" ]; do
    line="$(trim "${line%$'\r'}")"
    case "$line" in '## '*) sec="${line#\#\# }"; continue ;; esac
    q=""
    case "$sec" in
      Decisions)
        case "$line" in *' — «'*'»') q="${line##* — «}"; q="${q%»}" ;; esac ;;
      Corrections)
        case "$line" in
          ''|'- (none)') continue ;;
          '- «'*'» — '*) q="${line#- «}"; q="${q%» — *}" ;;
          *) echo "litopys distill record: a '## Corrections' line must read '- «<owner's exact words>» — <what it corrected>' (got: $line)" >&2
             return 2 ;;
        esac ;;
    esac
    [ -n "$q" ] || continue
    q="$(wsnorm "$q")"
    case "$hay" in
      *"$q"*) : ;;
      *) echo "litopys distill record: «$q» is not in the journal's ## user text word for word - quote the owner exactly or leave the quote out" >&2
         return 2 ;;
    esac
  done <<< "$body"

  # --- paths -------------------------------------------------------------------------------
  local root now rdate sidsafe rel file
  root="$(project_root)"
  now="${LITOPYS_NOW:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"
  rel="$(record_rel "$started" "$sid" "$now")"
  rdate="${rel#docs/chronicle/sessions/}"; rdate="${rdate:0:10}"
  [ -n "$started" ] || started="-"
  sidsafe="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9._-' '_')"
  file="$root/$rel"

  if [ -f "$file" ] && [ "$force" -ne 1 ]; then
    echo "litopys distill record: record exists: $rel (use --force)" >&2; return 2
  fi

  # --- assemble, redact, write (C11/C16) ---------------------------------------------------
  local jbytes bbytes tokens filter record tmp
  jbytes="$(bytes "$journal")"; jbytes="${jbytes:-0}"
  bbytes="$(printf '%s\n' "$body" | wc -c | tr -dc '0-9')"; bbytes="${bbytes:-0}"
  tokens=$(( (jbytes + bbytes) / 4 ))

  record="$(cat <<RECORD
---
litopys: session
version: 1
date: $rdate
session_id: $sid
started: $started
ended: $ended
branch: $branch
topics: $(csv_list "$topics")
links: $(csv_list "$links")
source: $source
tokens: $tokens
model: $model
---
$body
RECORD
)"

  guard_private "$root"
  if ! mkdir -p "$root/docs/chronicle/sessions"; then
    echo "litopys distill record: cannot create $root/docs/chronicle/sessions" >&2; return 2
  fi
  filter="$(redactor "$root")"
  tmp="$file.tmp.$$"
  # A filter that fails or prints nothing must not become a passthrough: the unfiltered record
  # is refused (exit 2, journal still queued) instead of written.
  if printf '%s\n' "$record" | redact_filter "$filter" > "$tmp" 2>/dev/null && [ -s "$tmp" ]; then
    mv "$tmp" "$file"
  else
    rm -f "$tmp" 2>/dev/null || true
    echo "litopys distill record: the redactor ($filter) failed - record not written, journal left in the queue" >&2
    return 2
  fi

  # --- one chronicle line, through cmd_append's own path (one writer for the monthly file) --
  cmd_append --kind session --ref "$rel" --note "$title" > /dev/null || true

  # --- the run manifest: exactly the paths this run wrote, repo-relative, one per line ------
  # `distill finish` commits these and nothing else (review round 1, major 3). Appended only
  # after a successful write - a refused `record` (exit 2) has returned long before here.
  if ensure_scratch "$root"; then
    printf '%s\ndocs/chronicle/%s.md\n' "$rel" "$(printf '%s' "$now" | cut -c1-7)" \
      >> "$root/.litopys/distill.paths"
  fi

  # --- the journal leaves the queue (C12: done/ only) --------------------------------------
  if ensure_scratch "$root" && mkdir -p "$root/.litopys/raw/done"; then
    mv -f "$journal" "$root/.litopys/raw/done/$sidsafe.md" 2>/dev/null || true
  fi

  # --- one C14 cost row --------------------------------------------------------------------
  if ensure_scratch "$root"; then
    printf '{"ts":"%s","session_id":"%s","record":"%s","journal_bytes":%s,"body_bytes":%s,"tokens_est":%s,"model":"%s","source":"%s","litopys":"%s"}\n' \
      "$(json_str "$now")" "$(json_str "$sid")" "$(json_str "$rel")" "$jbytes" "$bbytes" "$tokens" \
      "$(json_str "$model")" "$(json_str "$source")" "$(json_str "$VERSION")" \
      >> "$root/.litopys/distill.jsonl"
  fi

  printf '%s\n' "$rel"
  return 0
}

# --- distill next (C12) ---------------------------------------------------------------------
# The lock's mutex, the skip rule and the eligibility/cap logic. No git, no commit; the lock is
# released here only when nothing was selected - `distill finish` (story 05) releases it
# otherwise.

journal_scan() { # journal_scan <file> - prints "started<US>firstuser<US>lastheader<US>sid" (US =
                  # \x1f, not tab: bash `read` collapses consecutive IFS-whitespace delimiters,
                  # which would silently swallow an empty field - journals with no `## user`
                  # block need that middle field to stay empty and stay a field.
  local file="$1" fm=0 line key val started="" firstuser="" lastheader="" sid="" inuser=0 seen=0
  while IFS= read -r line || [ -n "$line" ]; do
    line="${line%$'\r'}"
    if [ "$fm" -eq 0 ] && [ "$line" = "---" ]; then fm=1; continue; fi
    if [ "$fm" -eq 1 ]; then
      if [ "$line" = "---" ]; then fm=2; continue; fi
      key="${line%%:*}"; val="$(trim "${line#*:}")"
      case "$key" in
        started)    started="$val" ;;
        session_id) sid="$val" ;;
      esac
      continue
    fi
    case "$line" in
      '## '*)
        lastheader="$line"
        if [ "$seen" -eq 0 ]; then
          case "$line" in '## user'*) inuser=1 ;; *) inuser=0 ;; esac
        else
          inuser=0
        fi
        continue
        ;;
    esac
    if [ "$inuser" -eq 1 ] && [ "$seen" -eq 0 ] && [ -n "$(trim "$line")" ]; then
      firstuser="$line"
      seen=1
      inuser=0
    fi
  done < "$file"
  printf '%s\x1f%s\x1f%s\x1f%s\n' "$started" "$firstuser" "$lastheader" "$sid"
}

distill_next() {
  local max=3
  while [ $# -gt 0 ]; do
    case "$1" in
      --max)
        if [ $# -lt 2 ]; then
          echo "litopys distill next: --max needs a value" >&2; usage; return 2
        fi
        max="$2"; shift 2 ;;
      *) echo "litopys distill next: unknown argument '$1'" >&2; usage; return 2 ;;
    esac
  done
  case "$max" in
    ''|*[!0-9]*|0) echo "litopys distill next: --max must be a positive integer (got '$max')" >&2; usage; return 2 ;;
  esac

  local root raw lock
  root="$(project_root)"
  raw="$root/.litopys/raw"
  lock="$root/.litopys/distill.lock"

  # --- the mutex: mkdir is atomic on every shell; a 30-minute-old lock dir is reclaimed once ---
  ensure_scratch "$root" || true
  if ! mkdir "$lock" 2>/dev/null; then
    # Reclaim by rename, then re-check what was renamed: a second reclaimer that saw the same
    # stale lock can only ever move a lock aside, and a fresh one it moved goes straight back.
    if [ -d "$lock" ] && [ -n "$(find "$lock" -maxdepth 0 -mmin +30 2>/dev/null)" ] \
      && mv "$lock" "$lock.stale.$$" 2>/dev/null; then
      if [ -n "$(find "$lock.stale.$$" -maxdepth 0 -mmin +30 2>/dev/null)" ]; then
        rm -rf "$lock.stale.$$" 2>/dev/null || true
      else
        # A fresh lock was moved: give it back, unless a third run has taken the name meanwhile -
        # then leave it aside rather than nest it or delete it (it may be live).
        [ -e "$lock" ] || mv "$lock.stale.$$" "$lock" 2>/dev/null || true
      fi
    fi
    if ! mkdir "$lock" 2>/dev/null; then
      echo "locked" >&2
      return 3
    fi
  fi
  printf '%s %s\n' "$$" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$lock/owner" 2>/dev/null || true

  mkdir -p "$raw" 2>/dev/null || true
  mkdir -p "$raw/skipped" 2>/dev/null || true

  local -a files=() remain=()
  local f
  for f in "$raw"/*.md; do
    [ -f "$f" ] || continue
    files+=("$f")
  done

  # --- eligibility FIRST, then the skip rule (review round 1, critical 1) -------------------
  # A journal whose session may still be running is never moved and never selected, whatever
  # its first line: otherwise the running `/litopys:distill` session's own journal is parked
  # mid-session, the Stop hook re-creates it as a headless fragment, and the next run distills
  # the plugin talking to itself. Only a journal that already passes eligibility (last block
  # `## closed`, or mtime older than 60 minutes) can be parked or selected.
  local skipped=0 started firstuser lastheader sid eligible
  local sidsafe park seq key tmplist=""
  for f in ${files[@]+"${files[@]}"}; do
    IFS=$'\x1f' read -r started firstuser lastheader sid < <(journal_scan "$f")
    eligible=0
    case "$lastheader" in
      '## closed'*) eligible=1 ;;
      *) if [ -n "$(find "$f" -maxdepth 0 -mmin +60 2>/dev/null)" ]; then eligible=1; fi ;;
    esac
    if [ "$eligible" -eq 0 ]; then
      remain+=("$f")
      continue
    fi

    # skip rule: a bench journal - and a journal with no `## user` block at all, which is what
    # a `/litopys:distill` run leaves behind - is parked in skipped/, never distilled.
    case "$firstuser" in
      ''|/litopys:recall*|/litopys:distill*)
        if mv -f "$f" "$raw/skipped/$(basename "$f")" 2>/dev/null; then
          skipped=$((skipped + 1))
        else
          remain+=("$f")
        fi
        continue
        ;;
    esac

    # review round 1, major 4: a session resumed after it was distilled gets a fresh journal
    # with the same session_id, which every `record` refuses (`record exists`) and which would
    # otherwise hold a cap slot forever. Park it - no merge, the resumed part is not chronicled.
    if [ -n "$sid" ] && [ -n "$started" ]; then
      if [ -f "$root/$(record_rel "$started" "$sid" "$started")" ]; then
        sidsafe="$(printf '%s' "$sid" | tr -c 'A-Za-z0-9._-' '_')"
        park="$raw/skipped/$sidsafe.resumed.md"
        seq=2
        while [ -e "$park" ]; do
          park="$raw/skipped/$sidsafe.resumed.$seq.md"
          seq=$((seq + 1))
        done
        if mv -f "$f" "$park" 2>/dev/null; then
          skipped=$((skipped + 1))
        else
          remain+=("$f")
        fi
        continue
      fi
    fi

    # --- a candidate: keep its sort key, the UTC ISO `started` (file mtime when absent) ------
    # ISO-8601 UTC sorts as text, so no `date -d` / `stat -c` (GNU-only; on BSD every key read
    # 0 and the queue order was silently wrong). `date -r <file>` is GNU, BSD and busybox alike.
    remain+=("$f")
    key="$started"
    case "$key" in
      [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]T[0-9][0-9]:[0-9][0-9]:[0-9][0-9]Z) : ;;
      *) key="$(date -u -r "$f" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null || true)"
         [ -n "$key" ] || key="0000-00-00T00:00:00Z" ;;
    esac
    # Real tab and newline, and `printf %s` below: `%b` would interpret the backslash escapes
    # of a Windows root (`\Users`, `\temp`, `\x..`) inside the path (review round 1, major 2).
    tmplist="$tmplist$key"$'\t'"$f"$'\n'
  done
  local pending=${#remain[@]}

  local -a selected=()
  local skey sfile
  while IFS=$'\t' read -r skey sfile; do
    [ -n "$sfile" ] || continue
    if [ "${#selected[@]}" -lt "$max" ]; then
      selected+=("$sfile")
    fi
  done < <(printf '%s' "$tmplist" | LC_ALL=C sort -t $'\t' -k1,1)

  local k=${#selected[@]}
  for f in ${selected[@]+"${selected[@]}"}; do
    printf '%s\n' "$f"
  done
  echo "skipped $skipped · pending $pending · selected $k" >&2

  # --- the lock releases itself only when nothing was selected; `distill finish` releases it
  # otherwise (C12) ----------------------------------------------------------------------------
  if [ "$k" -eq 0 ]; then
    rm -rf "$lock" 2>/dev/null || true
  fi
  return 0
}

# --- distill finish (C12/C14/C17) -----------------------------------------------------------
# Step 3 of the distiller. By default (C17) it only releases the lock: the records are
# git-ignored and stay local. With LITOPYS_TRACK_CHRONICLE=1 it commits *only the paths this run wrote* - the manifest
# `.litopys/distill.paths` that `distill record` appends to - on whatever branch the host is on,
# and release the lock. Never a gate: a repo that cannot take the commit keeps the records in the
# working tree and gets one line saying why, still exit 0. The host's index is never read and
# never written outside those paths - one `git add -- <paths>` and one pathspec-limited
# `git commit -- <paths>`, no `-a`, no `-A`, no `--no-verify`, and no `docs/chronicle` sweep
# (an unrelated host file under `docs/chronicle/` stays out of the distill commit).

git_block_reason() { # git_block_reason <root> - prints why this repo cannot take the commit ("" = it can)
  local root="$1" gitdir
  if [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]; then
    printf '%s\n' "not a git repository"; return 0
  fi
  gitdir="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null || true)"
  if [ -n "$gitdir" ]; then
    # In-progress operations first: a real rebase also leaves HEAD detached, and "rebase in
    # progress" is the more useful of the two reasons.
    [ -e "$gitdir/MERGE_HEAD" ] && { printf '%s\n' "merge in progress"; return 0; }
    if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
      printf '%s\n' "rebase in progress"; return 0
    fi
    [ -e "$gitdir/CHERRY_PICK_HEAD" ] && { printf '%s\n' "cherry-pick in progress"; return 0; }
    [ -e "$gitdir/REVERT_HEAD" ] && { printf '%s\n' "revert in progress"; return 0; }
  fi
  if [ -z "$(git -C "$root" symbolic-ref -q HEAD 2>/dev/null || true)" ]; then
    printf '%s\n' "detached HEAD"; return 0
  fi
  printf '%s\n' ""
}

git_error_line() { # git_error_line <stderr-file> - git's first real complaint, warnings skipped
  local f="$1" line
  line="$(awk 'NF && $0 !~ /^warning:/ { print; exit }' "$f" 2>/dev/null || true)"
  [ -n "$line" ] || line="$(awk 'NF { print; exit }' "$f" 2>/dev/null || true)"
  [ -n "$line" ] || line="git commit failed"
  printf '%s\n' "$(trim "$line")"
}

distill_finish() {
  if [ $# -gt 0 ]; then
    echo "litopys distill finish: takes no arguments (got '$1')" >&2; usage; return 2
  fi

  local root lock manifest reason="" n sha errfile
  root="$(project_root)"
  lock="$root/.litopys/distill.lock"
  manifest="$root/.litopys/distill.paths"

  # C17 - private by default: the records are written and git-ignored, so there is nothing to
  # commit and the manifest has done its job. Only the owner's explicit opt-in commits them.
  # The message says only what git confirms: every path this run wrote is checked with git's
  # own matcher before the line claims it is ignored.
  if [ "${LITOPYS_TRACK_CHRONICLE:-}" != "1" ]; then
    local why="docs/chronicle/ is git-ignored (LITOPYS_TRACK_CHRONICLE=1 commits it)" mp
    if [ "$(git -C "$root" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]; then
      why="not a git repository"
    elif [ -f "$manifest" ]; then
      while IFS= read -r mp || [ -n "$mp" ]; do
        mp="${mp%$'\r'}"
        [ -n "$mp" ] && [ -e "$root/$mp" ] || continue
        if ! git -C "$root" check-ignore -q -- "$mp" 2>/dev/null; then
          why="records NOT git-ignored - run bin/litopys privacy"; break
        fi
      done < "$manifest"
    fi
    rm -rf "$lock" 2>/dev/null || true
    rm -f "$manifest" 2>/dev/null || true
    printf 'kept local: %s\n' "$why"
    return 0
  fi

  # --- the manifest, deduplicated, in the order it was written ------------------------------
  local -a paths=()
  local p q dup
  if [ -f "$manifest" ]; then
    while IFS= read -r p || [ -n "$p" ]; do
      p="${p%$'\r'}"
      [ -n "$p" ] || continue
      [ -e "$root/$p" ] || continue
      dup=0
      for q in ${paths[@]+"${paths[@]}"}; do
        if [ "$q" = "$p" ]; then dup=1; break; fi
      done
      [ "$dup" -eq 0 ] || continue
      paths+=("$p")
    done < "$manifest"
  fi

  reason="$(git_block_reason "$root")"
  if [ -z "$reason" ]; then
    errfile="$(mktemp 2>/dev/null || { ensure_scratch "$root"; printf '%s' "$root/.litopys/.finish-stderr"; })"
    if [ "${#paths[@]}" -eq 0 ]; then
      reason="nothing to commit"
    elif ! git -C "$root" add -- ${paths[@]+"${paths[@]}"} 2>"$errfile"; then
      reason="$(git_error_line "$errfile")"
    elif [ -z "$(git -C "$root" diff --cached --name-only -- ${paths[@]+"${paths[@]}"} 2>/dev/null || true)" ]; then
      reason="nothing to commit"
    else
      # <n> is the number of distinct record paths this run wrote, never a row count from
      # distill.jsonl and never a line count off the diff: a `--force` re-distillation appends
      # a second chronicle line for the same session and must still say one (major 10 of the
      # same review is not this story's, but the path count gets it right for free).
      n=0
      for p in ${paths[@]+"${paths[@]}"}; do
        case "$p" in docs/chronicle/sessions/*.md) n=$((n + 1)) ;; esac
      done
      if git -C "$root" commit -m "chore(chronicle): distill $n session(s) [litopys]" -- ${paths[@]+"${paths[@]}"} > /dev/null 2>"$errfile"; then
        sha="$(git -C "$root" rev-parse --short=7 HEAD 2>/dev/null || true)"
      else
        reason="$(git_error_line "$errfile")"
      fi
    fi
    rm -f "$errfile" 2>/dev/null || true
  fi

  # The lock goes whatever happened - a refused commit must not wedge the next run (C12). The
  # manifest survives every refusal so a later `finish` commits the same paths; it goes once
  # they are in a commit, or once there is nothing left in it to commit.
  rm -rf "$lock" 2>/dev/null || true
  if [ -z "$reason" ] || [ "$reason" = "nothing to commit" ]; then
    rm -f "$manifest" 2>/dev/null || true
  fi

  if [ -n "$reason" ]; then
    printf 'uncommitted: %s\n' "$reason"
  else
    printf 'committed %s\n' "${sha:-unknown}"
  fi
  return 0
}

cmd_distill() {
  local verb="${1:-}"
  [ $# -gt 0 ] && shift
  case "$verb" in
    record) distill_record "$@"; return $? ;;
    next) distill_next "$@"; return $? ;;
    finish) distill_finish "$@"; return $? ;;
    "") echo "litopys distill: a verb is required (record, next, finish)" >&2; usage; return 2 ;;
    *) echo "litopys distill: unknown verb '$verb'" >&2; usage; return 2 ;;
  esac
}

# --- corrections (correction-evidence C3, ADR-011) -------------------------------------------
# Read-only. The owner's corrections as the records hold them, and - only with a lexicon the
# consumer passes (litopys ships none) - the raw journals' `## user` lines that match it.
# `## notice` text is never read. No model, no write; nothing found is still exit 0.

human_lines() { # human_lines <raw journal> - the non-blank lines of its `## user` blocks
  tr -d '\r' < "$1" | awk '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm == 1 { if ($0 == "---") fm = 2; next }
    /^## / { u = ($0 ~ /^## user/); next }
    u && NF { print }'
}

fm_value() { # fm_value <file> <key> - the first frontmatter value of <key>
  tr -d '\r' < "$1" | awk -v k="$2" '
    NR == 1 && $0 == "---" { fm = 1; next }
    fm == 1 && $0 == "---" { exit }
    fm == 1 && index($0, k ":") == 1 { v = substr($0, length(k) + 2); sub(/^[ \t]+/, "", v); print v; exit }'
}

cmd_corrections() {
  local since="" lexicon=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since|--lexicon)
        if [ $# -lt 2 ]; then echo "litopys corrections: $1 needs a value" >&2; usage; return 2; fi
        case "$1" in --since) since="$2" ;; --lexicon) lexicon="$2" ;; esac
        shift 2 ;;
      *) echo "litopys corrections: unknown argument '$1'" >&2; usage; return 2 ;;
    esac
  done
  case "$since" in
    ''|[0-9][0-9][0-9][0-9]-[0-1][0-9]-[0-3][0-9]) : ;;
    *) echo "litopys corrections: --since wants YYYY-MM-DD (got '$since')" >&2; usage; return 2 ;;
  esac
  if [ -n "$lexicon" ] && [ ! -f "$lexicon" ]; then
    echo "litopys corrections: no lexicon at $lexicon" >&2; return 2
  fi

  local root f line date sid sec q hit
  root="$(project_root)"
  for f in "$root"/docs/chronicle/sessions/*.md; do
    [ -f "$f" ] || continue
    date="$(fm_value "$f" date)"; sid="$(fm_value "$f" session_id)"
    if [ -n "$since" ] && [[ "$date" < "$since" ]]; then continue; fi
    sec=""
    while IFS= read -r line || [ -n "$line" ]; do
      line="${line%$'\r'}"
      case "$line" in '## '*) sec="${line#\#\# }"; continue ;; esac
      [ "$sec" = "Corrections" ] || continue
      case "$line" in
        '- «'*'» — '*) q="${line#- «}"; q="${q%» — *}"
                       printf '%s · %s · record · «%s»\n' "$date" "${sid:0:8}" "$q" ;;
      esac
    done < "$f"
  done

  [ -n "$lexicon" ] || return 0
  local pats
  pats="$(grep -v '^[[:space:]]*$' "$lexicon" 2>/dev/null)"
  [ -n "$pats" ] || return 0
  for f in "$root"/.litopys/raw/*.md "$root"/.litopys/raw/done/*.md; do
    [ -f "$f" ] || continue
    date="$(fm_value "$f" started)"; date="${date:0:10}"; sid="$(fm_value "$f" session_id)"
    if [ -n "$since" ] && [[ "$date" < "$since" ]]; then continue; fi
    while IFS= read -r hit; do
      [ -n "$hit" ] && printf '%s · %s · lexicon · «%s»\n' "$date" "${sid:0:8}" "$hit"
    done < <(human_lines "$f" | grep -Ei -e "$pats" 2>/dev/null)
  done
  return 0
}

SUB="${1:-help}"
[ $# -gt 0 ] && shift
case "$SUB" in
  append) cmd_append "$@"; exit $? ;;
  corrections) cmd_corrections "$@"; exit $? ;;
  bench) cmd_bench "$@"; exit $? ;;
  distill) cmd_distill "$@"; exit $? ;;
  privacy) cmd_privacy "$@"; exit $? ;;
  --version|-v|version) echo "$VERSION"; exit 0 ;;
  help|--help|-h) usage; exit 0 ;;
  *) echo "litopys: unknown subcommand '$SUB'" >&2; usage; exit 2 ;;
esac
